   {
    "line": 39,
    "kind": "块引",
    "pns": [
     "SJ-007-007"
    ],
    "quote": "西破秦军濮阳东，秦兵收入濮阳。沛公、项羽乃攻定陶。",
    "result": "逐字吻合"
   },
   {
    "line": 43,
    "kind": "转述",
    "pns": [
     "SJ-008-012"
    ],
    "result": "在证据包内"
   },
   {
    "line": 43,

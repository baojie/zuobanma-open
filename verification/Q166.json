   },
   {
    "line": 45,
    "kind": "块引",
    "pns": [
     "SJ-008-012"
    ],
    "quote": "军濮阳之东，与秦军战，破之。",
    "result": "逐字吻合"
   },
   {
    "line": 47,
    "kind": "块引",
    "pns": [
     "SJ-008-013"
    ],
    "quote": "秦军复振，守濮阳，环水。楚军去而攻定陶，定陶未下。",
    "result": "逐字吻合"
   },
   {
    "line": 53,
    "kind": "行内直引",
    "pns": [
     "SJ-054-002"
    ],
    "quote": "北救阿，击章邯军，陷陈，追至濮阳。",
    "result": "逐字吻合"
   },
   {
    "line": 54,
    "kind": "行内直引",
    "pns": [
     "SJ-057-002"
    ],
    "quote": "击秦军阿下，破之。追至濮阳，下甄城。",
    "result": "逐字吻合"
   },
   {
    "line": 55,
    "kind": "行内直引",
    "pns": [
     "SJ-095-002"
    ],
    "quote": "沛公击章邯军濮阳，攻城先登，斩首二十三级，赐爵列大夫。",
    "result": "逐字吻合"
   },
   {
    "line": 56,
    "kind": "行内直引",
    "pns": [
     "SJ-095-017"
    ],
    "quote": "常以太仆奉车从击章邯军东阿、濮阳下，以兵车趣攻战疾，破之，赐爵执珪。",
    "result": "逐字吻合"
   },
   {

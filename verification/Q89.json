    "pns": [
     "HS-028-064"
    ],
    "quote": "大夏",
    "result": "吻合（过短）"
   },
   {
    "line": 85,
    "kind": "行内直引",
    "pns": [
     "HS-022-008"
    ],
    "quote": "阳常居大夏而以生育长养为事，阴常居大冬",
    "result": "逐字吻合"
   },
   {

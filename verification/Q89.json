   {
    "line": 9,
    "kind": "块引",
    "pns": [
     "ZZ-182-018"
    ],
    "quote": "昔高辛氏有二子．伯曰阏伯．季曰实沈．居于旷林．不相能也．日寻干戈．以相征讨．后帝不臧．迁阏伯于商丘．主辰．商人是因．故辰为商星．迁实沈于大夏．主参．唐人是因．以服事夏商．",
    "result": "逐字吻合"
   },
   {
    "line": 11,
    "kind": "转述",
    "pns": [
     "ZZ-182-018"
    ],
    "result": "在证据包内"
   },
   {
    "line": 13,
    "kind": "转述",
    "pns": [
     "ZZ-179-010"
    ],
    "result": "在证据包内"
   },
   {
    "line": 13,
    "kind": "转述",
    "pns": [
     "ZZ-179-010"
    ],
    "result": "在证据包内"
   },
   {
    "line": 15,
    "kind": "块引",
    "pns": [
     "ZZ-179-010"
    ],
    "quote": "见舞大夏者．曰．美哉．勤而不德．非禹其谁能修之．",
    "result": "逐字吻合"
   },
   {
    "line": 17,
    "kind": "转述",
    "pns": [
     "ZZ-179-010"
    ],
    "result": "在证据包内"
   },
   {

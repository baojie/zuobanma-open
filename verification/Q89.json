    ],
    "result": "在证据包内"
   },
   {
    "line": 75,
    "kind": "行内直引",
    "pns": [
     "HS-099-031"
    ],
    "quote": "昔匈奴破大月氏，大月氏西君大夏，而塞王南君罽宾。",
    "result": "逐字吻合"
   },
   {
    "line": 75,
    "kind": "行内直引",
    "pns": [
     "HS-100-002"
    ],
    "quote": "大月氏徙西臣大夏，而乌孙昆莫居之",
    "result": "逐字吻合"
   },
   {
    "line": 77,
    "kind": "行内直引",
    "pns": [
     "HS-072-024"
    ],
    "quote": "大夏之西，以为彊汉不能臣也",
    "result": "逐字吻合"
   },
   {
    "line": 79,
    "kind": "行内直引",
    "pns": [
     "HS-108-117"
    ],
    "quote": "博望杖节，收功大夏；贰师秉钺，身衅胡社。",
    "result": "逐字吻合"
   },
   {
    "line": 83,
    "kind": "转述",
    "pns": [

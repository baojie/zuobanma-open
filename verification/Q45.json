    ],
    "quote": "诸侯卑秦、丑莫大焉",
    "result": "逐字吻合"
   },
   {
    "line": 19,
    "kind": "块引",
    "pns": [
     "SJ-005-055"
    ],
    "quote": "宾客群臣有能出奇计彊秦者，吾且尊官，与之分土。",

   },
   {
    "line": 87,
    "kind": "块引",
    "pns": [
     "HS-081-001"
    ],
    "quote": "秦攻上党，绝太行道，韩不能守，冯亭乃入上党城守于赵。赵封冯亭为华阳君，与赵将括距秦，战死于长平。",
    "result": "逐字吻合"
   },
   {
    "line": 91,
    "kind": "转述",
    "pns": [
     "HS-081-001"
    ],
    "result": "在证据包内"
   },
   {
    "line": 93,
    "kind": "行内直引",
    "pns": [
     "HS-028-141"
    ],
    "quote": "上党，本韩之别郡也，远韩近赵，后卒降赵，皆赵分也。",
    "result": "逐字吻合"
   },
   {
    "line": 95,
    "kind": "行内直引",
    "pns": [
     "HS-051-020"
    ],
    "quote": "卫先生为秦画长平之事，太白食昴，昭王疑之",
    "result": "逐字吻合"
   },
   {
    "line": 99,
    "kind": "行内直引",
    "pns": [
     "HS-072-029"
    ],
    "quote": "昔白起为秦将，南拔郢都，北阬赵括，以纤介之过，赐死杜邮，秦民怜之，莫不陨涕",
    "result": "分段吻合"
   },
   {
    "line": 100,
    "kind": "行内直引",
    "pns": [
     "HS-078-050"
    ],
    "quote": "昔白起为秦将，东破韩、魏，南拔郢都，应侯谮之，赐死杜邮",
    "result": "逐字吻合"
   },
   {
    "line": 102,
    "kind": "行内直引",
    "pns": [
     "HS-031-032"
    ],
    "quote": "白起为秦将，南并鄢郢，北阬马服",
    "result": "逐字吻合"
   },
   {
    "line": 104,
    "kind": "行内直引",
    "pns": [
     "HS-063-002"
    ],
    "quote": "蕲与武安君坑赵长平军，还而与之俱赐死杜邮",
    "result": "逐字吻合"
   },
   {
    "line": 106,
    "kind": "行内直引",
    "pns": [
     "HS-023-006"
    ],
    "quote": "孙、吴、商、白之徒，皆身诛戮于前，而功灭亡于后",
    "result": "逐字吻合"
   },

   {
    "line": 9,
    "kind": "块引",
    "pns": [
     "SJ-073-002"
    ],
    "quote": "秦兵日进，韩不能应，不如以上党归赵。赵若受我，秦怒，必攻赵。赵被兵，必亲韩。韩赵为一，则可以当秦。",
    "result": "逐字吻合"
   },
   {
    "line": 13,
    "kind": "转述",
    "pns": [
     "SJ-073-002"
    ],
    "result": "在证据包内"
   },
   {
    "line": 15,
    "kind": "行内直引",
    "pns": [
     "SJ-043-102"
    ],
    "quote": "欲嫁其祸赵也",
    "result": "原文已补回脱字（于）"
   },
   {
    "line": 15,
    "kind": "行内直引",
    "pns": [
     "SJ-043-103"
    ],
    "quote": "坐受城市邑十七，此大利，不可失也",
    "result": "逐字吻合"
   },
   {
    "line": 15,
    "kind": "行内直引",
    "pns": [
     "SJ-043-103"
    ],
    "quote": "廉颇将军军长平",
    "result": "吻合（过短）"
   },
   {
    "line": 17,
    "kind": "行内直引",
    "pns": [
     "SJ-045-032"
    ],
    "quote": "秦击我太行，我上党郡守以上党郡降赵",
    "result": "原文已补回脱字（于）"
   },
   {
    "line": 21,
    "kind": "行内直引",
    "pns": [
     "SJ-073-004"
    ],
    "quote": "廉颇坚壁以待秦，秦数挑战，赵兵不出",
    "result": "逐字吻合"
   },
   {
    "line": 23,
    "kind": "行内直引",
    "pns": [
     "SJ-076-011"
    ],
    "quote": "终不肯媾",
    "result": "吻合（过短）"
   },
   {
    "line": 25,
    "kind": "转述",
    "pns": [
     "SJ-046-052"
    ],
    "result": "在证据包内"
   },
   {
    "line": 29,
    "kind": "转述",
    "pns": [
     "SJ-073-004"
    ],
    "result": "在证据包内"
   },
   {
    "line": 31,
    "kind": "块引",
    "pns": [
     "SJ-073-004"
    ],
    "quote": "秦之所恶，独畏马服子赵括将耳，廉颇易与，且降矣。",
    "result": "逐字吻合"
   },
   {
    "line": 35,
    "kind": "行内直引",
    "pns": [
     "SJ-079-026"
    ],
    "quote": "昭王用应侯谋，纵反闲卖赵",
    "result": "逐字吻合"
   },
   {
    "line": 35,
    "kind": "转述",
    "pns": [
     "SJ-073-004"
    ],
    "result": "在证据包内"
   },
   {
    "line": 37,
    "kind": "转述",
    "pns": [
     "SJ-081-014"
    ],
    "result": "在证据包内"
   },
   {
    "line": 39,
    "kind": "块引",
    "pns": [
     "SJ-081-014"
    ],
    "quote": "王以名使括，若胶柱而鼓瑟耳。括徒能读其父书传，不知合变也。",
    "result": "逐字吻合"
   },
   {
    "line": 43,
    "kind": "行内直引",
    "pns": [
     "SJ-081-015"
    ],
    "quote": "破赵军者必括也",
    "result": "吻合（过短）"
   },
   {
    "line": 47,
    "kind": "行内直引",
    "pns": [
     "SJ-081-016"
    ],
    "quote": "士卒离心",
    "result": "吻合（过短）"
   },
   {
    "line": 47,
    "kind": "转述",
    "pns": [
     "SJ-073-004"
    ],
    "result": "在证据包内"
   },
   {
    "line": 47,

   },
   {
    "line": 61,
    "kind": "块引",
    "pns": [
     "SJ-006-030"
    ],
    "quote": "皇帝之功，勤劳本事。上农除末，黔首是富。",
    "result": "逐字吻合"
   },
   {
    "line": 63,
    "kind": "块引",
    "pns": [
     "SJ-006-030"
    ],
    "quote": "六合之内，皇帝之土。西涉流沙，南尽北户。东有东海，北过大夏。人迹所至，无不臣者。",
    "result": "逐字吻合"
   },
   {
    "line": 65,
    "kind": "行内直引",
    "pns": [
     "SJ-006-053"
    ],
    "quote": "夫为寄豭，杀之无罪",
    "result": "逐字吻合"
   },
   {
    "line": 66,
    "kind": "行内直引",
    "pns": [
     "SJ-028-020"
    ],
    "quote": "由此绌儒生",
    "result": "吻合（过短）"
   },
   {
    "line": 66,
    "kind": "转述",
    "pns": [
     "SJ-028-021"
    ],
    "result": "在证据包内"
   },
   {
    "line": 67,
    "kind": "转述",
    "pns": [
     "SJ-006-033"
    ],
    "result": "在证据包内"
   },
   {
    "line": 71,
    "kind": "转述",
    "pns": [
     "SJ-006-047"
    ],
    "result": "在证据包内"
   },
   {
    "line": 73,
    "kind": "块引",
    "pns": [
     "SJ-006-047"
    ],
    "quote": "有敢偶语诗书者弃市。以古非今者族。吏见知不举者与同罪。令下三十日不烧，黥为城旦。",
    "result": "逐字吻合"
   },
   {
    "line": 76,
    "kind": "行内直引",
    "pns": [
     "SJ-006-047"
    ],
    "quote": "以吏为师",
    "result": "吻合（过短）"
   },
   {
    "line": 79,
    "kind": "块引",
    "pns": [
     "SJ-006-050"
    ],
    "quote": "天下之事无小大皆决于上，上至以衡石量书，日夜有呈，不中呈不得休息。",
    "result": "逐字吻合"
   },
   {
    "line": 82,
    "kind": "行内直引",
    "pns": [
     "SJ-006-050"
    ],
    "quote": "犯禁者四百六十余人，皆阬之咸阳，使天下知之",
    "result": "逐字吻合"
   },
   {
    "line": 83,
    "kind": "转述",
    "pns": [
     "SJ-006-050"
    ],
    "result": "在证据包内"
   },
   {
    "line": 84,
    "kind": "行内直引",
    "pns": [
     "SJ-121-003"
    ],
    "quote": "焚诗书，阬术士，六艺从此缺焉",
    "result": "逐字吻合"
   },
   {
    "line": 84,
    "kind": "转述",
    "pns": [
     "SJ-121-014"
    ],
    "result": "在证据包内"
   },
   {
    "line": 90,
    "kind": "块引",
    "pns": [
     "SJ-006-011"
    ],
    "quote": "秦王为人，蜂准，长目，挚鸟膺，豺声，少恩而虎狼心，居约易出人下，得志亦轻食人。",
    "result": "逐字吻合"
   },
   {
    "line": 93,
    "kind": "转述",
    "pns": [
     "SJ-006-015"
    ],
    "result": "在证据包内"
   },
   {
    "line": 94,
    "kind": "转述",
    "pns": [
     "SJ-006-049"
    ],
    "result": "在证据包内"
   },
   {
    "line": 95,
    "kind": "转述",
    "pns": [
     "SJ-006-051"
    ],
    "result": "在证据包内"
   },
   {
    "line": 96,
    "kind": "转述",
    "pns": [
     "SJ-085-012"
    ],
    "result": "在证据包内"
   },
   {
    "line": 97,
    "kind": "行内直引",
    "pns": [
     "SJ-086-036"
    ],
    "quote": "终身不复近诸侯之人",
    "result": "逐字吻合"
   },
   {
    "line": 98,
    "kind": "行内直引",
    "pns": [
     "SJ-073-011"
    ],
    "quote": "夫秦王怚而不信人",
    "result": "逐字吻合"
   },
   {
    "line": 102,
    "kind": "转述",
    "pns": [
     "SJ-006-044"
    ],
    "result": "在证据包内"
   },
   {
    "line": 103,
    "kind": "转述",
    "pns": [
     "SJ-088-002"
    ],
    "result": "在证据包内"
   },
   {
    "line": 104,
    "kind": "转述",
    "pns": [
     "SJ-015-268"
    ],
    "result": "在证据包内"
   },
   {
    "line": 104,
    "kind": "转述",
    "pns": [
     "SJ-006-046"
    ],
    "result": "在证据包内"
   },
   {
    "line": 105,
    "kind": "行内直引",
    "pns": [
     "SJ-113-001"
    ],
    "quote": "以谪徙民，与越杂处",
    "result": "逐字吻合"
   },
   {
    "line": 105,
    "kind": "转述",
    "pns": [
     "SJ-114-001"
    ],
    "result": "在证据包内"
   },
   {
    "line": 106,
    "kind": "行内直引",
    "pns": [
     "SJ-112-012"
    ],
    "quote": "秦皇帝不听",
    "result": "吻合（过短）"
   },
   {
    "line": 106,
    "kind": "行内直引",
    "pns": [
     "SJ-112-012"
    ],
    "quote": "盖天下始畔秦也",
    "result": "吻合（过短）"
   },
   {
    "line": 110,
    "kind": "转述",
    "pns": [
     "SJ-028-024"
    ],
    "result": "在证据包内"
   },
   {
    "line": 110,
    "kind": "转述",
    "pns": [
     "SJ-006-044"
    ],
    "result": "在证据包内"
   },
   {
    "line": 111,
    "kind": "转述",
    "pns": [
     "SJ-006-054"
    ],
    "result": "在证据包内"
   },
   {
    "line": 112,
    "kind": "行内直引",
    "pns": [
     "SJ-118-019"
    ],
    "quote": "平原广泽，止王不来",
    "result": "逐字吻合"
   },
   {
    "line": 116,
    "kind": "转述",
    "pns": [
     "SJ-006-055"
    ],
    "result": "在证据包内"
   },
   {
    "line": 117,
    "kind": "行内直引",
    "pns": [
     "SJ-006-063"
    ],
    "quote": "山东郡县少年苦秦吏，皆杀其守尉令丞反",
    "result": "逐字吻合"
   },
   {
    "line": 120,
    "kind": "块引",
    "pns": [
     "SJ-089-006"
    ],
    "quote": "北有长城之役，南有五岭之戍，外内骚动，百姓罢敝，头会箕敛，以供军费，财匮力尽，民不聊生。",
    "result": "逐字吻合"
   },
   {
    "line": 123,
    "kind": "转述",
    "pns": [
     "SJ-006-069"
    ],
    "result": "在证据包内"
   },
   {
    "line": 125,
    "kind": "块引",
    "pns": [
     "SJ-006-075"
    ],
    "quote": "于是废先王之道，焚百家之言，以愚黔首。堕名城，杀豪俊，收天下之兵聚之咸阳，销锋铸鐻，以为金人十二，以弱黔首之民。",
    "result": "逐字吻合"
   },
   {
    "line": 127,
    "kind": "行内直引",
    "pns": [
     "SJ-088-011"
    ],
    "quote": "阿意兴功",
    "result": "吻合（过短）"
   },
   {
    "line": 128,
    "kind": "行内直引",
    "pns": [
     "SJ-130-025"
    ],
    "quote": "始皇既立，并兼六国，销锋铸鐻，维偃干革，尊号称帝，矜武任力",
    "result": "逐字吻合"
   },
   {
    "line": 129,
    "kind": "行内直引",
    "pns": [
     "SJ-006-124"
    ],
    "quote": "制作政令，施于后王",
    "result": "逐字吻合"
   },
   {
    "line": 129,
    "kind": "转述",
    "pns": [
     "SJ-006-126"
    ],
    "result": "在证据包内"
   },
   {
    "line": 129,
    "kind": "转述",
    "pns": [
     "SJ-006-126"
    ],
    "result": "在证据包内"
   },
   {
    "line": 135,
    "kind": "行内直引",
    "pns": [
     "SJ-006-075"
    ],
    "quote": "以弱黔首之民",
    "result": "吻合（过短）"
   },
   {
    "line": 135,
    "kind": "行内直引",
    "pns": [
     "HS-031-055"
    ],
    "quote": "以弱天下之民",
    "result": "吻合（过短）"
   },

    ],
    "result": "在证据包内"
   },
   {
    "line": 28,
    "kind": "行内直引",
    "pns": [
     "SJ-006-022"
    ],
    "quote": "德水",
    "result": "吻合（过短）"
   },
   {
    "line": 28,
    "kind": "转述",
    "pns": [
     "SJ-028-019"
    ],
    "result": "在证据包内"
   },
   {
    "line": 31,
    "kind": "块引",
    "pns": [
     "SJ-006-022"
    ],
    "quote": "刚毅戾深，事皆决于法，刻削毋仁恩和义，然后合五德之数。于是急法，久者不赦。",
    "result": "逐字吻合"
   },
   {
    "line": 38,
    "kind": "转述",
    "pns": [
     "SJ-006-025"
    ],

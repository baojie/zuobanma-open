   },
   {
    "line": 1,
    "kind": "转述",
    "pns": [
     "SJ-092-023"
    ],
    "result": "在证据包内"
   },
   {
    "line": 7,
    "kind": "行内直引",
    "pns": [
     "SJ-092-016"
    ],
    "quote": "吾困于此，旦暮望若来佐我，乃欲自立为王",
    "result": "逐字吻合"
   },
   {
    "line": 9,
    "kind": "块引",
    "pns": [
     "SJ-090-009"
    ],
    "quote": "齐王信之立，非君王之意，信亦不自坚。",
    "result": "逐字吻合"
   },
   {
    "line": 15,
    "kind": "块引",
    "pns": [
     "SJ-092-019"
    ],
    "quote": "且臣闻勇略震主者身危，而功盖天下者不赏。",
    "result": "逐字吻合"
   },
   {
    "line": 17,
    "kind": "块引",
    "pns": [
     "SJ-092-019"
    ],
    "quote": "今足下戴震主之威，挟不赏之功，归楚，楚人不信；归汉，汉人震恐：足下欲持是安归乎？",
    "result": "逐字吻合"
   },
   {
    "line": 23,
    "kind": "块引",
    "pns": [
     "SJ-092-020"
    ],
    "quote": "韩信犹豫不忍倍汉，又自以为功多，汉终不夺我齐，遂谢蒯通。",
    "result": "逐字吻合"
   },
   {
    "line": 25,
    "kind": "转述",
    "pns": [
     "SJ-092-021"
    ],
    "result": "在证据包内"
   },
   {
    "line": 25,
    "kind": "转述",
    "pns": [
     "SJ-008-052"
    ],
    "result": "在证据包内"
   },
   {
    "line": 29,
    "kind": "行内直引",
    "pns": [
     "SJ-092-023"
    ],
    "quote": "陈兵出入",
    "result": "吻合（过短）"
   },
   {
    "line": 29,
    "kind": "转述",
    "pns": [
     "SJ-056-011"
    ],
    "result": "在证据包内"
   },
   {
    "line": 31,
    "kind": "行内直引",
    "pns": [
     "SJ-056-011"
    ],
    "quote": "莫及也",
    "result": "吻合（过短）"
   },
   {
    "line": 33,
    "kind": "转述",
    "pns": [
     "SJ-092-023"
    ],
    "result": "在证据包内"
   },
   {
    "line": 33,
    "kind": "转述",
    "pns": [
     "SJ-092-023"
    ],
    "result": "在证据包内"
   },
   {
    "line": 35,
    "kind": "块引",
    "pns": [
     "SJ-092-023"
    ],
    "quote": "信曰：『果若人言，「狡兔死，良狗亨；高鸟尽，良弓藏；敌国破，谋臣亡。」天下已定，我固当亨！』上曰：『人告公反。』遂械系信。",
    "result": "逐字吻合"
   },
   {
    "line": 37,
    "kind": "行内直引",
    "pns": [
     "SJ-056-011"
    ],
    "quote": "若毋声！而反，明矣！",
    "result": "逐字吻合"
   },
   {
    "line": 39,
    "kind": "行内直引",
    "pns": [
     "SJ-018-044"
    ],
    "quote": "坐擅发兵，废为淮阴侯",
    "result": "逐字吻合"
   },
   {
    "line": 39,
    "kind": "转述",
    "pns": [
     "SJ-092-023"
    ],
    "result": "在证据包内"
   },
   {
    "line": 39,
    "kind": "转述",
    "pns": [
     "SJ-092-023"
    ],
    "result": "在证据包内"
   },
   {
    "line": 39,
    "kind": "转述",
    "pns": [
     "SJ-008-063"
    ],
    "result": "在证据包内"
   },
   {
    "line": 39,
    "kind": "转述",
    "pns": [
     "SJ-092-023"
    ],
    "result": "在证据包内"
   },
   {
    "line": 43,
    "kind": "转述",
    "pns": [
     "SJ-092-025"
    ],
    "result": "在证据包内"
   },
   {
    "line": 45,
    "kind": "块引",
    "pns": [
     "SJ-092-025"
    ],
    "quote": "公之所居，天下精兵处也；而公，陛下之信幸臣也。人言公之畔，陛下必不信；再至，陛下乃疑矣；三至，必怒而自将。吾为公从中起，天下可图也。",
    "result": "逐字吻合"
   },
   {
    "line": 49,
    "kind": "转述",
    "pns": [
     "SJ-092-025"
    ],
    "result": "在证据包内"
   },
   {
    "line": 51,
    "kind": "块引",
    "pns": [
     "SJ-092-025"
    ],
    "quote": "汉十年，陈豨果反。上自将而往，信病不从。阴使人至豨所，曰：『弟举兵，吾从此助公。』信乃谋与家臣夜诈诏赦诸官徒奴，欲发以袭吕后、太子。部署已定，待豨报。",
    "result": "逐字吻合"
   },
   {
    "line": 57,
    "kind": "块引",
    "pns": [
     "SJ-092-025"
    ],
    "quote": "其舍人得罪于信，信囚，欲杀之。舍人弟上变，告信欲反状于吕后。",
    "result": "逐字吻合"
   },
   {
    "line": 59,
    "kind": "行内直引",
    "pns": [
     "SJ-018-111"
    ],
    "quote": "为淮阴舍人，告淮阴侯信反",
    "result": "逐字吻合"
   },
   {
    "line": 61,
    "kind": "转述",
    "pns": [
     "SJ-092-025"
    ],
    "result": "在证据包内"
   },
   {
    "line": 61,
    "kind": "转述",
    "pns": [
     "SJ-092-025"
    ],
    "result": "在证据包内"
   },
   {
    "line": 63,
    "kind": "块引",
    "pns": [
     "SJ-092-025"
    ],
    "quote": "信入，吕后使武士缚信，斩之长乐钟室。信方斩，曰：『吾悔不用蒯通之计，乃为儿女子所诈，岂非天哉！』遂夷信三族。",
    "result": "逐字吻合"
   },
   {
    "line": 65,
    "kind": "行内直引",
    "pns": [
     "SJ-053-010"
    ],
    "quote": "吕后用萧何计，诛淮阴侯",
    "result": "逐字吻合"
   },
   {
    "line": 65,
    "kind": "行内直引",
    "pns": [
     "SJ-008-076"
    ],
    "quote": "淮阴侯韩信谋反关中，夷三族",
    "result": "逐字吻合"
   },
   {
    "line": 65,
    "kind": "行内直引",
    "pns": [
     "SJ-018-044"
    ],
    "quote": "十一年，信谋反关中，吕后诛信，夷三族，国除",
    "result": "逐字吻合"
   },
   {
    "line": 69,
    "kind": "行内直引",
    "pns": [
     "SJ-092-026"
    ],
    "quote": "且喜且怜之",
    "result": "吻合（过短）"
   },
   {
    "line": 71,
    "kind": "转述",
    "pns": [
     "SJ-053-010"
    ],
    "result": "在证据包内"
   },
   {
    "line": 71,
    "kind": "转述",
    "pns": [
     "SJ-053-010"
    ],
    "result": "在证据包内"
   },
   {
    "line": 75,
    "kind": "行内直引",
    "pns": [
     "SJ-091-013"
    ],
    "quote": "因心恐",
    "result": "吻合（过短）"
   },
   {
    "line": 77,
    "kind": "块引",
    "pns": [
     "SJ-091-015"
    ],
    "quote": "往年杀彭越，前年杀韩信，此三人者，同功一体之人也。自疑祸及身，故反耳。",
    "result": "逐字吻合"
   },
   {
    "line": 81,
    "kind": "块引",
    "pns": [
     "SJ-093-011"
    ],
    "quote": "往年春，汉族淮阴，夏，诛彭越，皆吕后计。今上病，属任吕后。吕后妇人，专欲以事诛异姓王者及大功臣。",
    "result": "逐字吻合"
   },
   {
    "line": 83,
    "kind": "行内直引",
    "pns": [
     "SJ-094-013"
    ],
    "quote": "甚矣蒯通之谋，乱齐骄淮阴，其卒亡此两人！",
    "result": "逐字吻合"
   },
   {
    "line": 87,
    "kind": "块引",
    "pns": [
     "SJ-092-027"
    ],
    "quote": "假令韩信学道谦让，不伐己功，不矜其能，则庶几哉，于汉家勋可以比周、召、太公之徒，后世血食矣。不务出此，而天下已集，乃谋畔逆，夷灭宗族，不亦宜乎！",
    "result": "逐字吻合"
   },
   {
    "line": 93,
    "kind": "转述",
    "pns": [
     "HS-034-016"
    ],
    "result": "在证据包内"
   },
   {
    "line": 93,
    "kind": "转述",
    "pns": [
     "HS-034-019"
    ],
    "result": "在证据包内"
   },
   {
    "line": 93,
    "kind": "转述",
    "pns": [
     "HS-034-022"
    ],
    "result": "在证据包内"
   },
   {
    "line": 93,
    "kind": "转述",
    "pns": [
     "HS-034-023"
    ],
    "result": "在证据包内"
   },
   {
    "line": 97,
    "kind": "行内直引",
    "pns": [
     "SJ-092-023"
    ],
    "quote": "信欲发兵反，自度无罪",
    "result": "逐字吻合"
   },
   {
    "line": 97,
    "kind": "行内直引",
    "pns": [
     "HS-034-019"
    ],
    "quote": "信欲发兵，自度无罪",
    "result": "逐字吻合"
   },
   {
    "line": 98,
    "kind": "行内直引",
    "pns": [
     "SJ-092-023"
    ],
    "quote": "高鸟尽，良弓藏；敌国破，谋臣亡。天下已定，我固当亨",
    "result": "分段吻合"
   },
   {
    "line": 98,
    "kind": "转述",
    "pns": [
     "HS-034-019"
    ],
    "result": "在证据包内"
   },
   {
    "line": 99,
    "kind": "行内直引",
    "pns": [
     "HS-034-019"
    ],
    "quote": "有变告信欲反，书闻，上患之",
    "result": "逐字吻合"
   },
   {
    "line": 100,
    "kind": "行内直引",
    "pns": [
     "HS-034-023"
    ],
    "quote": "阴使人之豨所，而与家臣谋",
    "result": "逐字吻合"
   },
   {
    "line": 100,
    "kind": "行内直引",
    "pns": [
     "SJ-092-025"
    ],
    "quote": "弟举兵，吾从此助公",
    "result": "逐字吻合"
   },
   {
    "line": 103,
    "kind": "转述",
    "pns": [
     "HS-034-023"
    ],
    "result": "在证据包内"
   },
   {
    "line": 105,
    "kind": "行内直引",
    "pns": [
     "HS-045-006"
    ],
    "quote": "悔不用蒯通之言，死于女子之手！",
    "result": "逐字吻合"
   },
   {
    "line": 107,
    "kind": "行内直引",
    "pns": [
     "HS-034-024"
    ],
    "quote": "且喜且哀之",
    "result": "吻合（过短）"
   },
   {
    "line": 107,
    "kind": "行内直引",
    "pns": [
     "SJ-092-026"
    ],
    "quote": "且喜且怜之",
    "result": "吻合（过短）"
   },
   {
    "line": 108,
    "kind": "行内直引",
    "pns": [
     "HS-034-024"
    ],
    "quote": "通至自说，释弗诛。语在通传",
    "result": "逐字吻合"
   },
   {
    "line": 108,
    "kind": "转述",
    "pns": [
     "HS-045-006"
    ],
    "result": "在证据包内"
   },
   {
    "line": 114,
    "kind": "块引",
    "pns": [
     "HS-023-024"
    ],
    "quote": "汉兴之初，虽有约法三章，网漏吞舟之鱼，然其大辟，尚有夷三族之令。令曰：「当三族者，皆先黥，劓，斩左右止，笞杀之，枭其首，菹其骨肉于市。其诽谤詈诅者，又先断舌。」故谓之具五刑。彭越、韩信之属皆受此诛。",
    "result": "逐字吻合"
   },
   {
    "line": 120,
    "kind": "块引",
    "pns": [
     "HS-048-019"
    ],
    "quote": "臣窃迹前事，大抵彊者先反。淮阴王楚最彊，则最先反",
    "result": "逐字吻合"
   },
   {
    "line": 122,
    "kind": "行内直引",
    "pns": [
     "HS-048-019"
    ],
    "quote": "虽至今存可也",
    "result": "吻合（过短）"
   },
   {
    "line": 126,
    "kind": "块引",
    "pns": [
     "HS-034-054"
    ],
    "quote": "见疑强大，怀不自安，事穷势迫，卒谋叛逆，终于灭亡。",
    "result": "逐字吻合"
   },
   {
    "line": 128,
    "kind": "行内直引",
    "pns": [
     "HS-045-039"
    ],
    "quote": "蒯通一说而丧三侊",
    "result": "原文已二校改字（侊→俊）"
   },
   {
    "line": 128,
    "kind": "行内直引",
    "pns": [
     "HS-108-085"
    ],
    "quote": "蒯通壹说，三雄是败，覆郦骄韩",
    "result": "逐字吻合"
   },
   {

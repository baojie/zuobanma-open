   {
    "line": 45,
    "kind": "块引",
    "pns": [
     "SJ-007-040"
    ],
    "quote": "力拔山兮气盖世，时不利兮骓不逝。骓不逝兮可柰何，虞兮虞兮柰若何！",
    "result": "逐字吻合"
   },
   {
    "line": 49,
    "kind": "转述",
    "pns": [

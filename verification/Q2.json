    "pns": [
     "SJ-007-033"
    ],
    "quote": "吾翁即若翁，必欲烹而翁，则幸分我一桮羹",
    "result": "逐字吻合"
   },
   {
    "line": 39,
    "kind": "行内直引",
    "pns": [
     "SJ-007-034"
    ],
    "quote": "吾宁斗智，不能斗力",
    "result": "逐字吻合"
   },
   {
    "line": 39,
    "kind": "行内直引",
    "pns": [
     "SJ-007-034"
    ],
    "quote": "目不敢视，手不敢发",
    "result": "逐字吻合"
   },
